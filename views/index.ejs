<section class="panel" style="width: 100%">
  <div class="panel-header">
    <h2 style="margin: 0">My Files</h2>
    <a href="/files/upload" class="btn btn-primary">Upload File</a>
  </div>

  <% if (files.length > 0) { %> <% files.forEach(f => { %>
  <div class="file-card">
    <div class="file-info">
      <div style="font-weight: 700"><%= f.originalName %></div>
      <div style="color: var(--muted); font-size: 13px; margin-top: 6px">
        <%= (f.size/(1024*1024)).toFixed(2) %> MB • <%= f.chunkCount %> chunks •
        <span class="status-badge status-<%= (f.uploadStatus || f.status) %>"
          ><%= f.uploadStatus || f.status %></span
        >
      </div>
    </div>
    <div class="file-actions">
      <a class="a-btn" href="/files/<%= f._id %>">View</a>
      <% if ((f.uploadStatus || f.status) === 'completed') { %>
      <a class="btn btn-outline" href="/files/<%= f._id %>/download"> Download </a>
      <% } %>
      <form
        action="/files/<%= f._id %>/delete"
        method="post"
        onsubmit="return confirm('Delete this file and all its chunks from Discord?');"
        style="display: inline"
      >
        <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
        <button class="btn btn-danger" type="submit">Delete</button>
      </form>
    </div>
  </div>
  <% }) %> <% } else { %>
  <div class="empty-state">
    <p>No files uploaded yet.</p>
    <a href="/files/upload" class="btn btn-primary">Upload your first file</a>
  </div>
  <% } %>
</section>
